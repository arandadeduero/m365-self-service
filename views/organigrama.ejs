<%- include('partials/header') %>

<% const top = chart.nodes[0]; %>
<main class="container-xxl py-4 page-shell page-organigrama">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <h1 class="h2 mb-0 page-title">Organigrama</h1>
    <div class="org-search">
      <input type="search" class="form-control" id="orgSearch" placeholder="Buscar por nombre, puesto o departamento"
        autocomplete="off" role="combobox" aria-expanded="false" aria-controls="orgSearchResults" aria-autocomplete="list">
      <div class="list-group shadow org-search-results d-none" id="orgSearchResults" role="listbox"></div>
    </div>
  </div>

  <p class="text-muted">
    Quién depende de quién en el Ayuntamiento, según el responsable que figura en el perfil de cada persona.
    Pulsa el botón <strong>+</strong> que hay bajo una tarjeta para ver a quién tiene a su cargo, o busca a alguien por su nombre.
    Si tu responsable no es el correcto, avísalo desde <a href="/">tu perfil</a>.
  </p>

  <% if (top) { %>
    <div class="card shadow-sm border-0 app-panel mb-4">
      <div class="card-body p-2 p-md-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="orgToolbar">
          <button type="button" class="btn btn-sm btn-primary d-none" data-org-action="me">Dónde estoy</button>
          <button type="button" class="btn btn-sm btn-outline-primary" data-org-action="expand">Desplegar todo</button>
          <button type="button" class="btn btn-sm btn-outline-primary" data-org-action="collapse">Plegar</button>
          <button type="button" class="btn btn-sm btn-outline-primary" data-org-action="fit">Ver entero</button>
          <div class="btn-group btn-group-sm ms-md-auto" role="group" aria-label="Tamaño">
            <button type="button" class="btn btn-outline-primary" data-org-action="zoom-out" aria-label="Alejar">−</button>
            <button type="button" class="btn btn-outline-primary" data-org-action="zoom-in" aria-label="Acercar">+</button>
          </div>
        </div>
        <div class="org-chart" id="orgChart"></div>
        <p class="text-muted mb-0 d-none" id="orgChartFailed">No se ha podido dibujar el organigrama. Vuelve a cargar la página; si sigue sin verse, puedes encontrar a cualquier persona en el <a href="/directorio">Directorio</a>.</p>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-warning">No se puede dibujar el organigrama: ninguna cuenta tiene un responsable asignado.</div>
  <% } %>

  <% if (chart.unplaced.length > 0) { %>
    <details class="card shadow-sm border-0 app-panel" id="orgUnplaced">
      <summary class="card-body p-3 p-md-4 h5 mb-0">Fuera del organigrama (<%= chart.unplaced.length %>)</summary>
      <div class="card-body p-3 p-md-4 pt-0 pt-md-0">
        <p class="text-muted">
          <% if (top) { %>
            Cuentas que no dependen de <%= top.name %>, ni directamente ni a través de sus responsables.
          <% } %>
          La mayoría son buzones y cuentas de servicio, que no tienen responsable; también aparece aquí quien no lo tiene puesto en su perfil.
        </p>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Puesto</th>
                <th>Departamento</th>
                <th>Responsable</th>
              </tr>
            </thead>
            <tbody>
              <% chart.unplaced.forEach(function(person) { %>
                <tr data-person-id="<%= person.id %>">
                  <td><strong><%= person.name %></strong></td>
                  <td><%= person.jobTitle %></td>
                  <td><%= person.department %></td>
                  <td><%= person.managerName || 'Sin responsable' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </details>
  <% } %>
</main>

<%# "<" is escaped so that a name containing "</script>" cannot end the block %>
<script type="application/json" id="orgChartData"><%- JSON.stringify({ nodes: chart.nodes, unplaced: chart.unplaced, currentUserId }).replace(/</g, '\\u003c') %></script>

<% if (top) { %>
<%# Copies kept in public/vendor so the page asks nothing of other servers %>
<script src="/vendor/d3-7.9.0.min.js"></script>
<script src="/vendor/d3-flextree-2.1.2.min.js"></script>
<script src="/vendor/d3-org-chart-3.1.1.min.js"></script>
<% } %>
<script src="/js/organigrama.js"></script>

<%- include('partials/footer') %>
