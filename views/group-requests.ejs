<%- include('partials/header') %>

<% const formatDate = (value) => new Date(value).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }); %>
<% const statusLabels = { pending: 'Pendiente', approved: 'Aprobada', rejected: 'Rechazada' }; %>
<% const statusBadges = { pending: 'bg-warning text-dark', approved: 'bg-success', rejected: 'bg-secondary' }; %>

<main class="container py-4 page-shell page-groups">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Solicitudes de grupos</h1>
    <div class="d-flex gap-2">
      <a href="/groups/owned" class="btn btn-outline-secondary">Grupos que administro</a>
      <a href="/groups" class="btn btn-outline-secondary">Volver a grupos</a>
    </div>
  </div>

  <p class="text-muted">
    El <strong>propietario</strong> de un grupo es quien decide quién entra en él. Si lo eres de alguno, aquí ves quién ha pedido unirse; y más abajo, cómo van tus propias solicitudes.
  </p>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Pendientes en tus grupos</h3>
      <% if (pending.length > 0) { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Persona</th>
                <th>Grupo</th>
                <th>Fecha</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% pending.forEach(function(request) { %>
                <tr>
                  <td><strong><%= request.requester.name %></strong><br><span class="text-muted small"><%= request.requester.email %></span></td>
                  <td><%= request.groupName %></td>
                  <td><%= formatDate(request.createdAt) %></td>
                  <td class="text-end">
                    <form action="/groups/requests/<%= request.id %>/approve" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <button type="submit" class="btn btn-primary btn-sm">Aprobar</button>
                    </form>
                    <form action="/groups/requests/<%= request.id %>/reject" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <button type="submit" class="btn btn-outline-secondary btn-sm">Rechazar</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <p class="text-muted small mb-0">Al aprobar, la persona se añade al grupo de inmediato.</p>
      <% } else { %>
        <p class="text-muted mb-0">No hay solicitudes pendientes en los grupos de los que eres propietario.</p>
      <% } %>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Mis solicitudes</h3>
      <% if (mine.length > 0) { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Grupo</th>
                <th>Fecha</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% mine.forEach(function(request) { %>
                <tr>
                  <td><%= request.groupName %></td>
                  <td><%= formatDate(request.createdAt) %></td>
                  <td><span class="badge <%= statusBadges[request.status] %>"><%= statusLabels[request.status] %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">No has solicitado unirte a ningún grupo.</p>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
