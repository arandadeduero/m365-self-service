<%- include('partials/header') %>

<main class="container py-4 page-shell page-profile">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title"><%= person.displayName %></h1>
    <a href="/directorio" class="btn btn-outline-secondary">Volver al directorio</a>
  </div>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4 d-flex flex-column flex-md-row gap-4">
      <div class="flex-grow-1">
        <% if (person.jobTitle) { %><p class="mb-1 fs-5"><%= person.jobTitle %></p><% } %>
        <% if (person.department) { %><p class="text-muted mb-3"><%= person.department %></p><% } %>
        <dl class="row mb-3">
          <% if (person.officeLocation) { %><dt class="col-sm-3">Oficina</dt><dd class="col-sm-9"><%= person.officeLocation %></dd><% } %>
          <% phones.forEach(function(phone) { %><dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9"><a href="tel:<%= phone %>" class="text-decoration-none"><%= phone %></a></dd><% }); %>
          <% if (person.mail) { %><dt class="col-sm-3">Correo</dt><dd class="col-sm-9"><a href="mailto:<%= person.mail %>" class="text-decoration-none"><%= person.mail %></a></dd><% } %>
        </dl>
        <div class="d-flex flex-wrap gap-2">
          <a href="/directorio/<%= person.id %>/vcard" class="btn btn-primary">Guardar contacto (.vcf)</a>
          <% if (person.mail) { %>
            <a href="https://teams.microsoft.com/l/chat/0/0?users=<%= encodeURIComponent(person.mail) %>" target="_blank" rel="noopener" class="btn btn-outline-primary">Chat en Teams</a>
          <% } %>
        </div>
      </div>
      <div class="text-center">
        <img src="<%= qr %>" alt="Código QR con los datos de contacto" width="220" height="220" class="border rounded">
        <p class="text-muted small mt-2 mb-0">Apunta con la cámara del móvil<br>para guardar el contacto</p>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
