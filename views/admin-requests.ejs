<%- include('partials/header') %>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Solicitudes pendientes</h1>
  </div>

  <p class="text-muted">Peticiones de entrar en un grupo que sus propietarios aún no han decidido. Solo ellos pueden aprobarlas; aquí se ve a quién reclamar.</p>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <% if (pending.length === 0) { %>
        <p class="text-muted mb-0">No hay solicitudes pendientes.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Grupo</th><th>Quién lo pide</th><th>Desde hace</th></tr></thead>
            <tbody>
              <% pending.forEach(function(request) { %>
                <tr class="<%= request.days >= 7 ? 'table-warning' : '' %>">
                  <td><strong><%= request.groupName %></strong></td>
                  <td><%= request.requester.name %> <span class="text-muted small"><%= request.requester.email %></span></td>
                  <td><%= request.days === 0 ? 'hoy' : `${request.days} ${request.days === 1 ? 'día' : 'días'}` %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
