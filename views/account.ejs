<%- include('partials/header') %>

<main class="container py-4 page-shell">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Mi cuenta</h1>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Tu cuenta está al <%= checklist.percent %> %</h3>
      <div class="progress mb-3" role="progressbar" aria-valuenow="<%= checklist.percent %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar <%= checklist.percent === 100 ? 'bg-success' : '' %>" style="width: <%= checklist.percent %>%"></div>
      </div>
      <ul class="list-group list-group-flush">
        <% checklist.items.forEach(function(item) { %>
          <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
            <span><%= item.done ? '✅' : '⬜' %> <%= item.label %></span>
            <% if (!item.done) { %>
              <% if (item.fix.url) { %>
                <a href="<%= item.fix.url %>" <% if (item.fix.external) { %>target="_blank" rel="noopener"<% } %> class="btn btn-outline-primary btn-sm"><%= item.fix.label %></a>
              <% } else { %>
                <span class="text-muted small"><%= item.fix.label %></span>
              <% } %>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Qué tengo</h3>
      <% if (owned.licenses.length > 0) { %>
        <p>
          Tu licencia:
          <% owned.licenses.forEach(function(license, index) { %><% if (index > 0) { %>, <% } %><strong><%= license.name %></strong><% if (license.name !== license.code) { %> <span class="text-muted small">(<%= license.code %>)</span><% } %><% }); %>
        </p>
        <% if (owned.apps.length > 0) { %>
          <p class="text-muted">Con ella puedes usar:</p>
          <ul class="list-group list-group-flush mb-3">
            <% owned.apps.forEach(function(app) { %>
              <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">
                <span><strong><%= app.name %></strong><br><span class="text-muted small"><%= app.description %></span></span>
                <a href="<%= app.url %>" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">Abrir</a>
              </li>
            <% }); %>
          </ul>
        <% } %>
      <% } else { %>
        <p class="text-muted">No tienes licencias asignadas.</p>
      <% } %>
      <% if (storage) { %>
        <p class="mb-1">Espacio en OneDrive: <strong><%= storage.used %></strong> usados de <%= storage.total %></p>
        <div class="progress" role="progressbar" aria-valuenow="<%= storage.percent %>" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar <%= storage.percent >= 90 ? 'bg-danger' : '' %>" style="width: <%= storage.percent %>%"></div>
        </div>
      <% } %>
      <a href="/account/groups" class="btn btn-outline-secondary mt-3">Mis grupos y qué me da cada uno</a>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Contraseña</h3>
      <% if (status.lastPasswordChangeDateTime) { %>
        <p>Último cambio: <strong><%= new Date(status.lastPasswordChangeDateTime).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong></p>
      <% } %>
      <% if (passwordDaysLeft !== null) { %>
        <% if (passwordDaysLeft <= 0) { %>
          <div class="alert alert-danger">Tu contraseña ha caducado. Cámbiala para seguir entrando.</div>
        <% } else if (passwordDaysLeft <= 14) { %>
          <div class="alert alert-warning">Tu contraseña caduca en <strong><%= passwordDaysLeft %></strong> <%= passwordDaysLeft === 1 ? 'día' : 'días' %>.</div>
        <% } else { %>
          <p>Caduca en <strong><%= passwordDaysLeft %></strong> días.</p>
        <% } %>
      <% } %>
      <a href="<%= changePasswordUrl %>" target="_blank" rel="noopener" class="btn btn-primary">Cambiar contraseña</a>
      <p class="text-muted small mt-2 mb-0">Se abre la página de Microsoft, que te pedirá la contraseña actual.</p>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Seguridad del inicio de sesión</h3>
      <p class="text-muted">Un <strong>segundo factor</strong> es algo que tienes, además de la contraseña que sabes: tu móvil con una aplicación o un SMS, o una llave física. Con él, quien averigüe tu contraseña no puede entrar en tu cuenta.</p>
      <% if (!security) { %>
        <p class="text-muted">No se han podido comprobar tus métodos de inicio de sesión.</p>
      <% } else { %>
        <% if (!security.hasSecondFactor) { %>
          <div class="alert alert-danger">
            Tu cuenta solo está protegida por la contraseña. Añade un segundo método, como la aplicación Microsoft Authenticator o tu teléfono, para que nadie pueda entrar aunque la averigüe.
          </div>
        <% } %>
        <ul class="list-group list-group-flush mb-3">
          <% security.list.forEach(function(method) { %>
            <li class="list-group-item px-0">
              <%= method.label %><% if (method.detail) { %> <span class="text-muted">(<%= method.detail %>)</span><% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
      <a href="<%= securityInfoUrl %>" target="_blank" rel="noopener" class="btn btn-outline-secondary">Gestionar métodos de inicio de sesión</a>
      <a href="/account/sign-ins" class="btn btn-outline-secondary">Mis inicios de sesión</a>
      <p class="text-muted small mt-2 mb-0">Los métodos se gestionan en la página de Microsoft. En tus inicios de sesión puedes ver dónde y cuándo se ha usado tu cuenta.</p>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Dispositivos</h3>
      <% if (devices && devices.length > 0) { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Dispositivo</th>
                <th>Sistema</th>
                <th>Último inicio de sesión</th>
              </tr>
            </thead>
            <tbody>
              <% devices.forEach(function(device) { %>
                <tr>
                  <td><strong><%= device.displayName %></strong></td>
                  <td><%= [device.operatingSystem, device.operatingSystemVersion].filter(Boolean).join(' ') %></td>
                  <td><%= device.approximateLastSignInDateTime ? new Date(device.approximateLastSignInDateTime).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : '' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <p class="text-muted small mb-0">Si no reconoces alguno, cambia la contraseña y avisa a Informática.</p>
      <% } else { %>
        <p class="text-muted mb-0">No hay dispositivos registrados a tu nombre.</p>
      <% } %>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Recuperación de la cuenta</h3>
      <% if (status.otherMails && status.otherMails.length > 0) { %>
        <p>Si olvidas la contraseña, el enlace para recuperarla se envía a <strong><%= status.otherMails[0] %></strong>.</p>
      <% } else { %>
        <div class="alert alert-warning">
          No tienes un correo personal registrado. Si olvidas la contraseña, el enlace para recuperarla se enviará al buzón de esta misma cuenta, al que quizá no puedas entrar. Pide a Informática que añada tu correo personal.
        </div>
      <% } %>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Correo</h3>
      <% if (!mailRules) { %>
        <p class="text-muted">No se han podido comprobar las reglas de tu buzón.</p>
      <% } else { %>
        <% if (mailRules.externalForwarding.length > 0) { %>
          <div class="alert alert-danger">
            Tu correo se está reenviando fuera del Ayuntamiento, a <strong><%= mailRules.externalForwarding.join(', ') %></strong>. Si no lo has configurado tú, cambia la contraseña y avisa a Informática.
          </div>
        <% } %>
        <% if (mailRules.list.length > 0) { %>
          <p class="text-muted">Reglas de tu bandeja de entrada, que actúan solas sobre el correo que recibes:</p>
          <ul class="list-group list-group-flush mb-3">
            <% mailRules.list.forEach(function(rule) { %>
              <li class="list-group-item px-0">
                <strong><%= rule.name %></strong><% if (!rule.enabled) { %> <span class="badge bg-secondary">Desactivada</span><% } %>
                <br><span class="text-muted small"><%= rule.effects.join('. ') %></span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>No tienes reglas en tu bandeja de entrada.</p>
        <% } %>
        <p class="text-muted small">Solo se comprueban tus propias reglas. Un reenvío configurado por un administrador en el buzón no aparece aquí.</p>
      <% } %>
      <a href="https://outlook.office.com/mail/options/mail/rules" target="_blank" rel="noopener" class="btn btn-outline-secondary">Ver mis reglas en Outlook</a>
      <a href="/profile/me/auto-reply" class="btn btn-outline-secondary">Respuestas automáticas</a>
      <% if (hasSharedMailboxes) { %>
        <a href="/account/mailboxes" class="btn btn-outline-secondary">Buzones compartidos</a>
      <% } %>
      <p class="text-muted small mt-2 mb-0">Las respuestas automáticas avisan a quien te escriba de que estás fuera de la oficina.</p>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mt-4" id="calendario">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Calendario</h3>
      <% if (calendarNotice) { %>
        <div class="alert alert-success"><%= calendarNotice %></div>
      <% } %>
      <% if (!calendarSharing) { %>
        <p class="text-muted">No se ha podido comprobar con quién compartes tu calendario.</p>
      <% } else { %>
        <% const outsiders = calendarSharing.filter(entry => entry.external); %>
        <% if (outsiders.length > 0) { %>
          <div class="alert alert-warning">
            Tu calendario está compartido con personas de fuera del Ayuntamiento: <strong><%= outsiders.map(entry => entry.email).join(', ') %></strong>. Si no lo has hecho tú, quítales el acceso y avisa a Informática.
          </div>
        <% } %>
        <% if (calendarSharing.length > 0) { %>
          <p class="text-muted">Estas personas pueden ver tu calendario. Quien solo ve si estás libre u ocupado no ve con quién ni para qué.</p>
          <ul class="list-group list-group-flush mb-3">
            <% calendarSharing.forEach(function(entry) { %>
              <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-3">
                <div>
                  <strong><%= entry.who %></strong><% if (entry.email) { %> <span class="text-muted small"><%= entry.email %></span><% } %>
                  <% if (entry.canChange) { %> <span class="badge bg-warning text-dark">Puede hacer cambios</span><% } %>
                  <br><span class="text-muted small"><%= entry.access %></span>
                </div>
                <% if (entry.removable) { %>
                  <form action="/account/calendar/<%= encodeURIComponent(entry.id) %>/remove" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                    <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">Quitar acceso</button>
                  </form>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>Nadie más puede ver tu calendario.</p>
        <% } %>
      <% } %>
      <% if (calendarSharing) { %>
        <form action="/account/calendar/share" method="POST" class="row g-2 align-items-end mb-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="col-md-5">
            <label for="shareEmail" class="form-label">Compartir con</label>
            <input type="email" class="form-control" id="shareEmail" name="email" placeholder="nombre@<%= domain %>" required>
          </div>
          <div class="col-md-5">
            <label for="shareRole" class="form-label">Qué puede ver</label>
            <select class="form-select" id="shareRole" name="role">
              <% Object.entries(calendarRoles).forEach(function([value, label]) { %>
                <option value="<%= value %>"><%= label %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Compartir</button>
          </div>
        </form>
        <p class="text-muted small">Solo con personas del Ayuntamiento. Para compartirlo con alguien de fuera, o nombrar a un delegado, hazlo desde Outlook.</p>
      <% } %>
      <a href="https://outlook.office.com/calendar/options/calendar/SharedCalendars" target="_blank" rel="noopener" class="btn btn-outline-secondary">Abrir en Outlook</a>
      <a href="/salas" class="btn btn-outline-secondary">Buscar una sala libre</a>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
