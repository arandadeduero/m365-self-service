<%- include('partials/header') %>

<main class="container-xxl py-4 page-shell page-profile">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Mi firma de correo</h1>
    <div class="d-flex gap-2">
      <% if (generatorUrl) { %><a href="<%= generatorUrl %>" target="_blank" rel="noopener" class="btn btn-outline-secondary">Abrir en una pestaña</a><% } %>
      <a href="/account" class="btn btn-outline-secondary">Volver a mi cuenta</a>
    </div>
  </div>

  <p class="text-muted">
    El generador del Ayuntamiento hace la firma con el formato oficial y el logo de tu concejalía. Rellena los campos con los datos de tu perfil, que tienes aquí al lado, y pulsa <strong>Copiar vista previa</strong> para pegarla en Outlook.
    <% if (missing.length > 0) { %>
      En tu perfil falta <%= missing.map(field => field === 'jobTitle' ? 'el puesto' : 'el departamento').join(' y ') %>; puedes ponerlo en <a href="/profile/me/edit">Editar mi perfil</a>.
    <% } %>
  </p>

  <div class="row g-4">
    <div class="col-lg-3">
      <div class="card shadow-sm border-0 app-panel">
        <div class="card-body p-4">
          <h2 class="h6 text-muted text-uppercase mb-3">Tus datos</h2>
          <dl class="mb-0">
            <% details.forEach(function([label, value]) { %>
              <dt class="small text-muted"><%= label %></dt>
              <dd class="text-break"><%= value %></dd>
            <% }); %>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-lg-9">
      <% if (generatorUrl) { %>
        <iframe src="<%= generatorUrl %>" title="Generador de firmas de correo del Ayuntamiento" class="signature-generator" allow="clipboard-write" loading="lazy"></iframe>
      <% } else { %>
        <div class="card shadow-sm border-0 app-panel"><div class="card-body p-4"><p class="text-muted mb-0">El generador de firmas no está configurado.</p></div></div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
