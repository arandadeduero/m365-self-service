<%- include('partials/header') %>

<main class="container py-4 page-shell page-profile">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Editar Perfil</h1>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <% if (notice) { %>
        <div class="alert alert-warning">
          Microsoft no permite que cambies tú estos datos: <strong><%= notice.refused.join(', ') %></strong>.
          <% if (notice.savedOthers) { %>El resto de cambios se ha guardado.<% } %>
          Pide el cambio a Informática.
        </div>
      <% } %>
      <% const fields = [
        { name: 'jobTitle', label: 'Puesto de trabajo', value: user.jobTitle },
        { name: 'mobilePhone', label: 'Teléfono móvil', value: user.mobilePhone },
        { name: 'businessPhones', label: 'Extensión (teléfono de empresa)', value: user.businessPhones && user.businessPhones[0] },
        { name: 'officeLocation', label: 'Ubicación de oficina', value: user.officeLocation },
      ]; %>
      <form action="/profile/me/edit" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <% fields.forEach(function(field) { %>
          <div class="mb-3">
            <label for="<%= field.name %>" class="form-label"><%= field.label %></label>
            <% if (locked.includes(field.name)) { %>
              <input type="text" class="form-control" id="<%= field.name %>" value="<%= field.value || '' %>" disabled>
              <div class="form-text">Este dato solo puede cambiarlo Informática.</div>
            <% } else { %>
              <input type="text" class="form-control" id="<%= field.name %>" name="<%= field.name %>" value="<%= field.value || '' %>">
            <% } %>
          </div>
        <% }); %>
        <div class="d-flex gap-2">
          <% if (locked.length < fields.length) { %>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
          <% } %>
          <a href="/" class="btn btn-outline-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Foto de perfil</h3>
      <form action="/profile/me/photo" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <div class="mb-3">
          <label for="photo" class="form-label">Imagen (JPG o PNG, máximo 4 MB)</label>
          <input type="file" class="form-control" id="photo" name="photo" accept="image/jpeg,image/png" required>
        </div>
        <button type="submit" class="btn btn-primary">Cambiar foto</button>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <h3 class="h5 mb-3">Datos del usuario (JSON)</h3>
      <div class="json-container">
        <pre><code><%= JSON.stringify(user, null, 2) %></code></pre>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>