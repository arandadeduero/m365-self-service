<%- include('partials/header') %>

<main class="container py-4 page-shell page-groups">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Mi equipo</h1>
  </div>

  <% if (sent) { %>
    <div class="alert alert-success">Solicitud enviada: <strong><%= sent %></strong>. Informática la recibe en <%= adminEmail %> y te contestará a tu correo.</div>
  <% } %>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h2 class="h5 mb-3">Las personas a tu cargo</h2>
      <% if (!reports) { %>
        <p class="text-muted mb-0">Ahora mismo no se puede consultar quién depende de ti.</p>
      <% } else if (reports.length === 0) { %>
        <p class="text-muted mb-0">Nadie tiene puesto que depende de ti. Si no es así, pide la corrección desde el <a href="/">perfil</a> de cada persona o escribe a Informática.</p>
      <% } else { %>
        <p class="text-muted">Según el responsable que figura en el perfil de cada persona. Si falta alguien o sobra, es ahí donde se corrige.</p>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Nombre</th><th>Puesto</th><th>Departamento</th><th>Teléfono</th><th>Correo</th><th></th></tr></thead>
            <tbody>
              <% reports.forEach(function(person) { %>
                <tr>
                  <td><strong><%= person.displayName %></strong></td>
                  <td><%= person.jobTitle %></td>
                  <td><%= person.department %></td>
                  <td><%= [...(person.businessPhones || []), person.mobilePhone].filter(Boolean).join(', ') %></td>
                  <td><% if (person.mail) { %><a href="mailto:<%= person.mail %>" class="text-decoration-none"><%= person.mail %></a><% } %></td>
                  <td class="text-end"><a href="/directorio/<%= person.id %>" class="btn btn-outline-primary btn-sm">Tarjeta</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <h2 class="h4 mb-3">Solicitudes a Informática</h2>
  <p class="text-muted">Lo que un responsable suele necesitar, con los datos que Informática pide siempre, para no ir y venir por correo. Cada solicitud sale desde tu buzón y la respuesta te llega a ti.</p>

  <div class="accordion" id="requests">
    <% Object.entries(requests).forEach(function([kind, request]) { %>
      <div class="accordion-item">
        <h3 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#request-<%= kind %>" aria-expanded="false" aria-controls="request-<%= kind %>"><%= request.title %></button>
        </h3>
        <div id="request-<%= kind %>" class="accordion-collapse collapse" data-bs-parent="#requests">
          <div class="accordion-body">
            <p class="text-muted"><%= request.intro %></p>
            <form action="/equipo/solicitud/<%= kind %>" method="POST" class="row g-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <% request.fields.forEach(function(field) { %>
                <div class="<%= field.type === 'textarea' ? 'col-12' : 'col-md-6' %>">
                  <label for="<%= kind %>-<%= field.name %>" class="form-label"><%= field.label %><% if (field.required) { %> *<% } %></label>
                  <% if (field.type === 'textarea') { %>
                    <textarea class="form-control" id="<%= kind %>-<%= field.name %>" name="<%= field.name %>" rows="3" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %>></textarea>
                  <% } else if (field.type === 'select') { %>
                    <select class="form-select" id="<%= kind %>-<%= field.name %>" name="<%= field.name %>">
                      <% field.options.forEach(function(option) { %><option><%= option %></option><% }); %>
                    </select>
                  <% } else { %>
                    <input type="<%= field.type || 'text' %>" class="form-control" id="<%= kind %>-<%= field.name %>" name="<%= field.name %>" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %>>
                  <% } %>
                </div>
              <% }); %>
              <div class="col-12"><button type="submit" class="btn btn-primary">Enviar a Informática</button></div>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>
