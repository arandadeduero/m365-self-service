<%- include('partials/header') %>

<main class="container py-4 page-shell page-groups">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Grupos que administro</h1>
    <div class="d-flex gap-2">
      <a href="/groups/requests" class="btn btn-outline-secondary">Solicitudes</a>
      <a href="/groups" class="btn btn-outline-secondary">Volver a grupos</a>
    </div>
  </div>

  <p class="text-muted">
    Eres <strong>propietario</strong> de estos grupos: decides quién forma parte de ellos. Conviene revisar de vez en cuando quién sigue dentro, sobre todo si hay personas de fuera del Ayuntamiento.
  </p>

  <% if (groups.length > 0) { %>
    <% groups.forEach(function(group) { %>
      <div class="card shadow-sm border-0 app-panel mb-3">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <div>
            <h3 class="h5 mb-1"><%= group.displayName %></h3>
            <span class="badge bg-secondary"><%= group.about.label %></span>
            <% if (group.onlyOwner) { %>
              <span class="badge bg-warning text-dark">Eres el único propietario</span>
              <p class="text-muted small mt-2 mb-0">Si te vas o estás de baja, nadie más podrá gestionarlo. Pide a Informática que añada a otra persona como propietaria.</p>
            <% } %>
          </div>
          <a href="/groups/owned/<%= encodeURIComponent(group.id) %>" class="btn btn-outline-primary">Ver miembros</a>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="card shadow-sm border-0 app-panel">
      <div class="card-body p-4">
        <p class="text-muted mb-0">No eres propietario de ningún grupo.</p>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
