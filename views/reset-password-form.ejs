<%- include('partials/header') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="h3 mb-4">Establecer nueva contraseña</h2>
          <p class="text-secondary mb-4">
            Usuario: <%= email %>
          </p>

          <form action="/reset-password/<%= token %>" method="POST" id="resetPasswordForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            
            <div class="mb-3">
              <label for="newPassword" class="form-label">Nueva contraseña</label>
              <div class="input-group">
                <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                <button class="btn btn-outline-secondary" type="button" data-toggle-password="newPassword" aria-label="Mostrar u ocultar la contraseña">👁️</button>
              </div>
            </div>
            
            <div class="mb-3">
              <label for="confirmPassword" class="form-label">Confirmar contraseña</label>
              <div class="input-group">
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                <button class="btn btn-outline-secondary" type="button" data-toggle-password="confirmPassword" aria-label="Mostrar u ocultar la contraseña">👁️</button>
              </div>
            </div>
            
            <button type="submit" class="btn btn-primary w-100">Actualizar contraseña</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="/js/reset-password.js"></script>

<%- include('partials/footer') %>
