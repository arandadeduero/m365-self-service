<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= appName %> · <%= orgName %></title>

  <!-- Bootstrap 5 and the Outfit typeface are served by the app (public/vendor): pages load nothing from other servers -->
  <link rel="stylesheet" href="/vendor/bootstrap-5.3.3.min.css">

  <!-- Custom CSS (declares the typeface) -->
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100 app-shell">
  <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <div class="bg-danger text-white text-center py-1 fw-bold">
      ADMIN
    </div>
  <% } %>
  <% if (typeof serviceIssues !== 'undefined' && serviceIssues.length > 0) { %>
    <div class="alert alert-warning rounded-0 border-0 mb-0 py-2 text-center" role="status">
      <strong>Incidencia en Microsoft 365:</strong>
      <%= serviceIssues.slice(0, 3).map(issue => `${issue.service}: ${issue.title}`).join(' · ') %>
    </div>
  <% } %>
  <% if (typeof currentPage !== 'undefined' && currentPage !== 'login') { %>
  <nav class="navbar navbar-expand-lg app-nav border-bottom shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="/"><%= appName %></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegacion">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a href="/" class="nav-link <%= currentPage === 'profile' ? 'active' : '' %>">Perfil</a>
          </li>
          <li class="nav-item">
            <a href="/groups" class="nav-link <%= currentPage === 'groups' ? 'active' : '' %>">Grupos</a>
          </li>
          <li class="nav-item">
            <a href="/teams" class="nav-link <%= currentPage === 'teams' ? 'active' : '' %>">Teams</a>
          </li>
          <li class="nav-item">
            <a href="/organigrama" class="nav-link <%= currentPage === 'organigrama' ? 'active' : '' %>">Organigrama</a>
          </li>
          <li class="nav-item">
            <a href="/directorio" class="nav-link <%= currentPage === 'directory' ? 'active' : '' %>">Directorio</a>
          </li>
          <li class="nav-item">
            <a href="/account" class="nav-link <%= currentPage === 'account' ? 'active' : '' %>">Mi cuenta</a>
          </li>
          <li class="nav-item">
            <a href="/salas" class="nav-link <%= currentPage === 'rooms' ? 'active' : '' %>">Salas</a>
          </li>
          <li class="nav-item">
            <a href="/ayuda" class="nav-link <%= currentPage === 'help' ? 'active' : '' %>">Ayuda</a>
          </li>
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <li class="nav-item">
            <a href="/admin/audit" class="nav-link <%= currentPage === 'audit' ? 'active' : '' %>">Auditoría</a>
          </li>
          <% } %>
          <li class="nav-item">
            <a href="/blog" class="nav-link <%= currentPage === 'blog' ? 'active' : '' %>">Blog</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <% } %>
