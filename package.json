{
  "name": "mi-microsoft-365",
  "version": "1.0.0",
  "description": "Mi Microsoft 365 - Portal de autoservicio de Microsoft 365 del Ayuntamiento de Aranda de Duero",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test ava",
    "test:watch": "NODE_ENV=test ava --watch"
  },
  "keywords": [
    "microsoft-365",
    "azure-ad",
    "entra-id",
    "oauth2",
    "authentication",
    "express",
    "msal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1148.0",
    "@azure/msal-node": "^7.0.1",
    "axios": "^1.20.0",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "ava": "^8.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "2m",
    "verbose": true,
    "nodeArguments": [
      "--no-warnings"
    ]
  }
}
