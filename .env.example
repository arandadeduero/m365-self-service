# Azure/Entra ID Configuration
# Get these values from Azure Portal after registering your application

# Application (client) ID - Found in App Registration Overview
CLIENT_ID=your-application-client-id-here

# Client Secret Value - Create in Certificates & Secrets (copy immediately!)
CLIENT_SECRET=your-client-secret-value-here

# Directory (tenant) ID - Found in App Registration Overview
TENANT_ID=your-tenant-id-here

# Application Configuration
# Local development redirect URI
REDIRECT_URI=http://localhost:3000/auth/callback

# Session secret - Generate with: openssl rand -base64 32
SESSION_SECRET=generate-a-random-secret-string-here

# Port for local development
PORT=3000

# Environment (development or production)
NODE_ENV=development

# Number of reverse proxies in front of the app (leave unset if there is none).
# Needed for rate limiting to see the real client address
# TRUST_PROXY=1

# Directory for the audit log, one file per day (default: ./audit)
# AUDIT_DIR=/var/log/mi-microsoft-365

# Directory for the requests to join groups (default: ./data)
# DATA_DIR=/var/lib/mi-microsoft-365

# Days a password lasts in your tenant. When set, the account page shows how
# many days are left; leave unset if passwords do not expire
# PASSWORD_MAX_AGE_DAYS=90

# Profile fields users may change themselves (default: all four). List only
# the ones your tenant lets a user edit; the rest are shown read-only
# PROFILE_EDITABLE_FIELDS=mobilePhone,businessPhones,jobTitle,officeLocation

# Intranet linked from the home page, the help page and the footer
# INTRANET_URL=https://your-tenant.sharepoint.com

# Address of the person at the top of the org chart. Without it, or when
# nobody has that address, the top is whoever has people below and no manager
# ORG_CHART_ROOT=top-person@your-domain.es

# Mailbox that receives manager correction and group access requests, reported
# sign-ins and the messages written from the help page
ADMIN_EMAIL=admin@your-domain.es

# WordPress Configuration
WP_URL=https://tu-sitio-wordpress.es
WP_USER=nombre_usuario_wp
WP_APP_PASSWORD=tu_token_generado
JETPACK_POST_BY_EMAIL=zzzzzzzzz@post.wordpress.com

# AWS SES Configuration
AWS_REGION=your-aws-region-here
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
FROM_EMAIL=your-verified-ses-sender-email-here

# Token Secret for Reset Password (generate with: openssl rand -base64 32)
TOKEN_SECRET=generate-a-random-secret-string-here

# Reset links one IP address may request every 15 minutes (default 5)
# RESET_RATE_LIMIT=5
